FROM ubuntu:24.04

# Install SSH, Node.js, Git, and utilities
RUN apt update && apt install -y openssh-server sudo curl git nodejs npm

# Install PM2 globally
RUN npm install -g pm2

# Create deployer user without hardcoding UID (lets Linux pick an available ID)
RUN useradd -rm -d /home/deployer -s /bin/bash -g root -G sudo deployer
RUN echo 'deployer:password123' | chpasswd

# Prepare application directory
RUN mkdir -p /var/www/my-app && chown -R deployer:root /var/www/my-app

# Start SSH daemon
RUN service ssh start
EXPOSE 22 3000

CMD ["/usr/sbin/sshd", "-D"]